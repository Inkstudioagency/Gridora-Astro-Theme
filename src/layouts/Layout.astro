---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

// Order matters - the theme sheet overrides the base sheet, which overrides
// normalize. Astro bundles them into a single hashed stylesheet.
import '../styles/astro-build.css';
import '../styles/normalize.css';
import '../styles/gridora-base.css';
import '../styles/gridora-theme.css';
import '../styles/vendor-lenis.css';

interface Props {
  /** Page <title>. Also used for og:title / twitter:title. */
  title: string;
  /** Meta description. Falls back to the site-wide description. */
  description?: string;
  /** Social share image. Falls back to the site-wide image. */
  ogImage?: string;
  /**
   * Page id. The interaction data baked into `gridora-interactions.js` is keyed
   * by this value, so every page must pass its own id or the scroll and hover
   * animations defined for it will not run.
   */
  pageId: string;
  /** Page-specific critical CSS, inlined ahead of the interaction runtime. */
  pageStyle?: string;
}

const { title, description = site.description, ogImage = site.ogImage, pageId, pageStyle } = Astro.props;
---

<!DOCTYPE html>
<html data-gx-page={pageId} lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={ogImage} property="og:image" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImage} name="twitter:image" />
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    {pageStyle && <style is:inline set:html={pageStyle} />}
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">WebFont.load({  google: {    families: ["Mona Sans:300,400,500,600,700"]  }});</script>
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />
  </head>
  <body>
    <div class="page-wrapper">
      <Header />
      <slot />
      <Footer />
    </div>

    <!--
      Everything below is self-hosted on purpose: no third-party CDN is needed
      to render or animate the page. Order matters - GSAP and its plugins must
      be parsed before the interaction runtime and the animation setup run.
    -->
    <script is:inline src="/js/vendor/jquery.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/gsap.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/SplitText.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/ScrollTrigger.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/lenis.min.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">gsap.registerPlugin(SplitText,ScrollTrigger);</script>
    <script is:inline src="/js/gridora-interactions.js" type="text/javascript"></script>
    <script is:inline src="/js/gridora-animations.js"></script>
    <script is:inline src="/js/gridora-lenis.js"></script>
  </body>
</html>
