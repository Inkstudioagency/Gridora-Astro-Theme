---
import type { Portfolio } from '../lib/content';

interface Props {
  portfolio: Portfolio;
  /** 1-4. Drives the `is-N` position modifiers on the staggered grid. */
  position: number;
  /** Interaction id for the card entrance. Only the first card animates in. */
  cardWId?: string;
  /** Interaction id for the "Read More" hover fill. */
  buttonWId: string;
}

const { portfolio, position, cardWId, buttonWId } = Astro.props;

const entrance = cardWId
  ? 'opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)'
  : undefined;
const buttonFill =
  '-webkit-transform:translate3d(-101%, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(-101%, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(-101%, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(-101%, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)';
---

<div role="listitem" class="case-study-collection-item w-dyn-item">
  <div data-w-id={cardWId} style={entrance} class={`case-study-card-block is-${position}`}>
    <div class="case-study-card-image-block"><img src={portfolio.thumbnail} loading="lazy" alt={portfolio.title} class="case-study-card-image"></div>
    <div class="case-study-card-content-block">
      <div class="case-study-card-text-block">
        <h3 class="heading-style-5">{portfolio.title}</h3>
        <p class="text-size-regular">{portfolio.summary}</p>
      </div>
      <div class="case-study-card-info-block">
        <div class="case-study-single-info-block">
          <div class="case-study-info-title">Solutions</div>
          <p class="text-size-regular">{portfolio.solutions}</p>
        </div>
        <div class="case-study-single-info-block">
          <div class="case-study-info-title">Tool</div>
          <p class="text-size-regular">{portfolio.tool}</p>
        </div>
      </div>
      <div class="case-study-card-button-block">
        <a data-w-id={buttonWId} href={`/portfolio/${portfolio.slug}`} class="case-study-card-button w-inline-block">
          <div class="case-study-button-icon w-embed"><svg width="31" height="16" viewbox="0 0 31 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 1.2931C0 0.578942 0.578942 0 1.2931 0H7C11.4183 0 15 3.58172 15 8C15 12.4183 11.4183 16 7 16H1.2931C0.578942 16 0 15.4211 0 14.7069V1.2931Z" fill="currentColor"></path>
              <path d="M15 0.689655C15 0.308769 15.3088 0 15.6897 0C19.727 0 23 3.27295 23 7.31034V8.68966C23 12.727 19.727 16 15.6897 16C15.3088 16 15 15.6912 15 15.3103V0.689655Z" fill="currentColor"></path>
              <path d="M23 0.689655C23 0.308769 23.3088 0 23.6897 0C27.727 0 31 3.27295 31 7.31034V8.68966C31 12.727 27.727 16 23.6897 16C23.3088 16 23 15.6912 23 15.3103V0.689655Z" fill="currentColor"></path>
            </svg></div>
          <div class="case-study-button-text">Read More</div>
          <div style={buttonFill} class="button-background-block"></div>
        </a>
      </div>
    </div>
  </div>
  <div class={`case-study-card-bg is-${position}`}></div>
</div>
