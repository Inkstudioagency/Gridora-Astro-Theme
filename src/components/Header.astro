---
import { getFeatures, getPortfolios } from '../lib/content';

// The two "CMS Pages" links point at whichever entry the CMS returns first, so
// they keep working when the content changes.
const [features, portfolios] = await Promise.all([getFeatures(), getPortfolios()]);
const featureDetailsHref = features.length ? `/features/${features[0].slug}` : '/features';
const portfolioDetailsHref = portfolios.length ? `/portfolio/${portfolios[0].slug}` : '/';

const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isCurrent = (href: string) => href === path;
// Webflow marks the active link with both an aria-current attribute and the
// `w--current` class its stylesheet targets.
const current = (href: string) => (isCurrent(href) ? 'page' : undefined);
const cx = (base: string, href: string) => (isCurrent(href) ? `${base} w--current` : base);
