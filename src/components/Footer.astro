              </p>
            </div>
            <div class="footer-bottom-link-block">
              <a href="/style-guide" aria-current={current('/style-guide')} class={cx('footer-bottom-link', '/style-guide')}>Style Guide</a>
              <a href="/404" aria-current={current('/404')} class={cx('footer-bottom-link', '/404')}>Not Found</a>
            </div>
          </div>
          <div class="footer-logo-content-block"><img loading="lazy" src="/images/footer-bottom-logo.svg" alt="footer-bottom-logo" class="footer-bottom-logo"></div>
        </div>
