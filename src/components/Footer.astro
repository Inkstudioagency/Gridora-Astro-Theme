                <a href="/contact" aria-current={current('/contact')} class={cx('footer-link', '/contact')}>Contact</a>
              </div>
              <div class="footer-contact-info-block">
                <div class="footer-link-title">Contact</div>
                <div class="footer-contact-single-block">
