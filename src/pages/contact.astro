---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact || AI technology Astro theme" pageId="6a706af464122f0e823f294f">
      <main class="main-wrapper">
        <section class="section_breadcrumb">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="breadcrumb-wrapper">
              <div class="breadcrumb-content-block">
                <div class="breadcrumb-subtitle-block">
                  <div class="breadcrumb-subtitle-icon w-embed"><svg width="31" height="16" viewbox="0 0 31 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0 1.2931C0 0.578942 0.578942 0 1.2931 0H7C11.4183 0 15 3.58172 15 8C15 12.4183 11.4183 16 7 16H1.2931C0.578942 16 0 15.4211 0 14.7069V1.2931Z" fill="white"></path>
                      <path d="M15 0.689655C15 0.308769 15.3088 0 15.6897 0C19.727 0 23 3.27295 23 7.31034V8.68966C23 12.727 19.727 16 15.6897 16C15.3088 16 15 15.6912 15 15.3103V0.689655Z" fill="white"></path>
                      <path d="M23 0.689655C23 0.308769 23.3088 0 23.6897 0C27.727 0 31 3.27295 31 7.31034V8.68966C31 12.727 27.727 16 23.6897 16C23.3088 16 23 15.6912 23 15.3103V0.689655Z" fill="white"></path>
                    </svg></div>
                  <div class="text-size-small text-weight-medium text-color-white">Info</div>
                </div>
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-1 title-animation">Contact Us</h1>
                </div>
                <div data-w-id="0af1b63d-5fed-e2f1-0755-71ef0d5bd06f" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="breadcrumb-summary-block">
                  <p class="text-size-large text-color-heading-color-0-8">Fill out the form below and we&#x27;ll get back to you within 24 hours.</p>
                </div>
              </div>
            </div>
          </div>
        </section>
        <section class="section_contact">
          <div class="section-gap">
            <div class="w-layout-blockcontainer container-main w-container">
              <div class="contact-wrapper">
                <div class="contact-heading-block">
                  <div class="section-heading-block bottom-gap-none">
                    <div class="section-subtitle-block"><img loading="lazy" src="/images/subtitle-icon.svg" alt="subtitle-icon" class="subtitle-icon">
                      <div class="text-size-small text-weight-medium text-color-white">Get In Touch</div>
                    </div>
                    <div class="section-title-block top-space max-width-24-5rem">
                      <h2 class="heading-style-2 title-animation">We are ready, <span class="heading-style-2-ht">Fast Contact us</span></h2>
                    </div>
                    <div class="section-summary-block top-space max-width-29rem">
                      <p class="text-size-large">Every great company starts with a problem that needs solving. Here&#x27;s how Gridora came to be.</p>
                    </div>
                  </div>
                  <div class="contact-info-block">
                    <div class="contact-single-info-block">
                      <div class="contact-info-icon-block">
                        <div class="contact-info-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15.5 11C15.5 12.933 13.933 14.5 12 14.5C10.067 14.5 8.5 12.933 8.5 11C8.5 9.067 10.067 7.5 12 7.5C13.933 7.5 15.5 9.067 15.5 11Z" stroke="white" stroke-width="1.5"></path>
                            <path d="M12 2C16.8706 2 21 6.03298 21 10.9258C21 15.8965 16.8033 19.3847 12.927 21.7567C12.6445 21.9162 12.325 22 12 22C11.675 22 11.3555 21.9162 11.073 21.7567C7.2039 19.3616 3 15.9137 3 10.9258C3 6.03298 7.12944 2 12 2Z" stroke="white" stroke-width="1.5"></path>
                          </svg></div>
                      </div>
                      <div class="contact-info-text-block">
                        <h3 class="heading-style-5">Visit Our Office</h3>
                        <p class="text-size-large">123 Example Street, Suite 100, Example City, EX 00000</p>
                      </div>
                    </div>
                    <div class="contact-single-info-block">
                      <div class="contact-info-icon-block">
                        <div class="contact-info-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 8L10.89 13.26C11.2187 13.4793 11.6049 13.5963 12 13.5963C12.3951 13.5963 12.7813 13.4793 13.11 13.26L21 8M5 19H19C19.5304 19 20.0391 18.7893 20.4142 18.4142C20.7893 18.0391 21 17.5304 21 17V7C21 6.46957 20.7893 5.96086 20.4142 5.58579C20.0391 5.21071 19.5304 5 19 5H5C4.46957 5 3.96086 5.21071 3.58579 5.58579C3.21071 5.96086 3 6.46957 3 7V17C3 17.5304 3.21071 18.0391 3.58579 18.4142C3.96086 18.7893 4.46957 19 5 19Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg></div>
                      </div>
                      <div class="contact-info-text-block">
                        <h3 class="heading-style-5">Email Us</h3>
                        <p class="text-size-large">
                          <a href="mailto:hello@example.com" class="contact-info-link">hello@example.com</a><br>
                          <a href="mailto:support@example.com" class="contact-info-link">support@example.com</a>
                        </p>
                      </div>
                    </div>
                    <div class="contact-single-info-block">
                      <div class="contact-info-icon-block">
                        <div class="contact-info-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.15826 5.71223L8.7556 4.80625C8.49232 4.21388 8.36068 3.91768 8.16381 3.69101C7.91708 3.40694 7.59547 3.19794 7.23568 3.08785C6.94859 3 6.62446 3 5.97621 3C5.02791 3 4.55376 3 4.15573 3.18229C3.68687 3.39702 3.26344 3.86328 3.09473 4.3506C2.95151 4.76429 2.99254 5.18943 3.07458 6.0397C3.94791 15.0902 8.90982 20.0521 17.9603 20.9255C18.8106 21.0075 19.2358 21.0485 19.6494 20.9053C20.1368 20.7366 20.603 20.3132 20.8178 19.8443C21 19.4463 21 18.9721 21 18.0238C21 17.3756 21 17.0515 20.9122 16.7644C20.8021 16.4046 20.5931 16.083 20.309 15.8362C20.0824 15.6394 19.7862 15.5077 19.1938 15.2444L18.2878 14.8418C17.6463 14.5567 17.3255 14.4141 16.9996 14.3831C16.6876 14.3534 16.3731 14.3972 16.0811 14.5109C15.776 14.6297 15.5064 14.8544 14.967 15.3039C14.4302 15.7512 14.1618 15.9749 13.8338 16.0947C13.543 16.201 13.1586 16.2403 12.8524 16.1952C12.5069 16.1443 12.2424 16.0029 11.7133 15.7202C10.0673 14.8405 9.15953 13.9328 8.27987 12.2868C7.99714 11.7577 7.85578 11.4932 7.80487 11.1477C7.75974 10.8415 7.79908 10.4571 7.9053 10.1663C8.02512 9.83828 8.24881 9.56986 8.69619 9.033C9.14562 8.49368 9.37034 8.22402 9.48915 7.91891C9.60285 7.62694 9.64662 7.3124 9.61695 7.00048C9.58594 6.67452 9.44338 6.35376 9.15826 5.71223Z" stroke="white" stroke-width="1.5" stroke-linecap="round"></path>
                          </svg></div>
                      </div>
                      <div class="contact-info-text-block">
                        <h3 class="heading-style-5">Call Us</h3>
                        <p class="text-size-large">Sales: <a href="tel:+1(555)123-456" class="contact-info-link">+1 (555) 123-456 </a><br>Support: <a href="tel:+1(555)789-012" class="contact-info-link">+1 (555) 789-012</a>
                        </p>
                      </div>
                    </div>
                    <div class="contact-single-info-block">
                      <div class="contact-info-icon-block">
                        <div class="contact-info-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="white" stroke-width="1.5"></path>
                            <path d="M12 8V12L14 14" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg></div>
                      </div>
                      <div class="contact-info-text-block">
                        <h3 class="heading-style-5">Office Hours</h3>
                        <p class="text-size-large">Office Hours Monday - Friday 9:00 AM - 6:00 PM</p>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="contact-content-block">
                  <div id="contact-form" class="contact-form-block w-form">
                    <form id="wf-form-contact-form" name="wf-form-contact-form" data-name="contact-form" method="get" class="contact-form-inner" data-wf-page-id="6a706af464122f0e823f294f" data-wf-element-id="4324c71e-6696-03e2-ab51-2d91a24ae5a6">
                      <div class="contact-form-content">
                        <div data-w-id="a5255d3c-2299-4a62-d376-c8d36d06218c" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="form-heading-block">
                          <h3 class="heading-style-5">Get in Touch</h3>
                        </div>
                        <div data-w-id="a57cad72-f97f-791d-a48d-14435b11a246" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="form-field-block"><label for="name" class="form-field-label">Full name</label><input class="form-text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="John Doe" type="text" id="name" required=""></div>
                        <div data-w-id="d8a8c861-9d98-5e6e-b77e-9d473cd776ae" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="form-field-block"><label for="email" class="form-field-label">Email</label><input class="form-text-field w-input" maxlength="256" name="email" data-name="email" placeholder="hello@example.com" type="email" id="email" required=""></div>
                        <div data-w-id="10b5597f-e2f2-e94e-5cd3-26facac9e4a7" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="form-field-block"><label for="Subject" class="form-field-label">Subject</label><select id="Subject" name="Subject" data-name="Subject" required="" class="form-text-field select w-select">
                            <option value="">Branding</option>
                            <option value="First">First choice</option>
                            <option value="Second">Second choice</option>
                            <option value="Third">Third choice</option>
                          </select></div>
                        <div data-w-id="d4685a24-a430-bd1a-6bd9-7c22e21e4c5f" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="form-field-block"><label for="field-2" class="form-field-label">Message</label><textarea placeholder="Write your message here" maxlength="5000" id="Message" name="Message" data-name="Message" class="form-text-field large w-input"></textarea></div>
                        <div data-w-id="88a723c0-146f-da9d-e4aa-7ee90ea9af5f" style="opacity:0;-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);filter:blur(12px)" class="form-button-block"><input type="submit" data-wait="Please wait..." class="primary-button w-button" value="Send A Message"></div>
                      </div>
                    </form>
                    <div class="w-form-done">
                      <div>Thank you! Your submission has been received!</div>
                    </div>
                    <div class="w-form-fail">
                      <div>Oops! Something went wrong while submitting the form.</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <div class="page-liner-block">
          <div class="page-liner"></div>
          <div class="page-liner"></div>
          <div class="page-liner"></div>
          <div class="page-liner"></div>
          <div class="page-liner"></div>
        </div>
      </main>
</Layout>
