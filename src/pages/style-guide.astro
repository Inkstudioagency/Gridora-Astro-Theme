---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Style Guide || AI technology Astro theme" pageId="6a706af464122f0e823f2942">
      <main class="main-wrapper">
        <section class="section_style-guide">
          <div class="section-gap">
            <div class="w-layout-blockcontainer container-main w-container">
              <div class="style-guide-wrapper">
                <div class="section-heading-block">
                  <div class="section-title-block">
                    <h1 class="heading-style-2 text-color-white title-animation">Style Guide</h1>
                  </div>
                  <div class="section-summary-block top-space">
                    <p class="paragraph-small">The visual foundation and design system of our SaaS platform.</p>
                  </div>
                </div>
                <div class="style-guide-content-block">
                  <div class="style-guide-single-content">
                    <div class="style-guide-content-left-block">
                      <div class="style-guide-content-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M13.5 7C13.7761 7 14 6.77614 14 6.5C14 6.22386 13.7761 6 13.5 6C13.2239 6 13 6.22386 13 6.5C13 6.77614 13.2239 7 13.5 7Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M17.5 11C17.7761 11 18 10.7761 18 10.5C18 10.2239 17.7761 10 17.5 10C17.2239 10 17 10.2239 17 10.5C17 10.7761 17.2239 11 17.5 11Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M8.5 8C8.77614 8 9 7.77614 9 7.5C9 7.22386 8.77614 7 8.5 7C8.22386 7 8 7.22386 8 7.5C8 7.77614 8.22386 8 8.5 8Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M6.5 13C6.77614 13 7 12.7761 7 12.5C7 12.2239 6.77614 12 6.5 12C6.22386 12 6 12.2239 6 12.5C6 12.7761 6.22386 13 6.5 13Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M12 2C6.5 2 2 6.5 2 12C2 17.5 6.5 22 12 22C12.926 22 13.648 21.254 13.648 20.312C13.648 19.875 13.468 19.477 13.211 19.187C12.921 18.898 12.773 18.535 12.773 18.062C12.7692 17.8419 12.8098 17.6233 12.8922 17.4192C12.9747 17.2151 13.0975 17.0298 13.2531 16.8741C13.4088 16.7185 13.5941 16.5957 13.7982 16.5132C14.0023 16.4308 14.2209 16.3902 14.441 16.394H16.437C19.488 16.394 21.992 13.891 21.992 10.84C21.965 6.012 17.461 2 12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg></div>
                      <div class="label-medium">Color Palette</div>
                    </div>
                    <div class="style-guide-content-right-block">
                      <div class="color-content-block">
                        <div class="color-single-block">
                          <div class="color-block bg-color"></div>
                          <div class="color-info-block">
                            <div class="label-medium text-weight-semi-bold text-color-big-stone">BG Color</div>
                            <div class="color-code">#060606</div>
                          </div>
                        </div>
                        <div class="color-single-block">
                          <div class="color-block heading-color"></div>
                          <div class="color-info-block">
                            <div class="label-medium text-weight-semi-bold text-color-big-stone">Heading Color</div>
                            <div class="color-code">#161616</div>
                          </div>
                        </div>
                        <div class="color-single-block">
                          <div class="color-block hover-color"></div>
                          <div class="color-info-block">
                            <div class="label-medium text-weight-semi-bold text-color-big-stone">Hover Color</div>
                            <div class="color-code">#e4b46c</div>
                          </div>
                        </div>
                        <div class="color-single-block">
                          <div class="color-block black-color"></div>
                          <div class="color-info-block">
                            <div class="label-medium text-weight-semi-bold text-color-big-stone">black-color</div>
                            <div class="color-code">#000000</div>
                          </div>
                        </div>
                        <div class="color-single-block">
                          <div class="color-block white-color"></div>
                          <div class="color-info-block">
                            <div class="label-medium text-weight-semi-bold text-color-big-stone">white-color</div>
                            <div class="color-code">#ffffff</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="style-guide-single-content">
                    <div class="style-guide-content-left-block">
                      <div class="style-guide-content-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M4 7V4H20V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M9 20H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M12 4V20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg></div>
                      <div class="label-medium">Typography</div>
                    </div>
                    <div class="style-guide-content-right-block">
                      <div class="typography-content-block">
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <h1 class="text-color-white">Heading 1</h1>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Medium • 72px • 1.3 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <h2>Heading 2</h2>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Medium • 48px • 1.3 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <h3>Heading 3</h3>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Medium • 40px • 1.3 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <h4>Heading 4</h4>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Medium • 32px • 1.3 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <h5>Heading 5</h5>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Medium • 24px • 1.3 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <h6>Heading 6</h6>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Medium • 20px • 1.3 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <p class="text-size-large">Paragraph Large: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Regular • 28px • 1.5 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <p class="text-size-regular">Paragraph Regular: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Regular • 16px • 1.5 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <p class="text-size-small">Paragraph Small: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Regular • 14px • 1.5 Line Height</div>
                          </div>
                        </div>
                        <div class="typography-single-block">
                          <div class="typography-text-block">
                            <p class="text-size-xsmall">Paragraph Xsmall: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                          </div>
                          <div class="typography-info-block">
                            <div class="paragraph-xsmall text-weight-medium">Mona Sans • Regular • 12px • 1.5 Line Height</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="style-guide-single-content border-none">
                    <div class="style-guide-content-left-block">
                      <div class="style-guide-content-icon w-embed"><svg width="24" height="24" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M4.0369 4.6879C3.99743 4.59682 3.98626 4.49597 4.00484 4.39846C4.02342 4.30094 4.07088 4.21127 4.14108 4.14108C4.21127 4.07088 4.30094 4.02342 4.39846 4.00484C4.49597 3.98626 4.59682 3.99743 4.6879 4.0369L20.6879 10.5369C20.7852 10.5765 20.8675 10.6458 20.9232 10.7349C20.9789 10.824 21.0051 10.9283 20.9981 11.0331C20.9912 11.138 20.9514 11.2379 20.8844 11.3188C20.8174 11.3997 20.7266 11.4575 20.6249 11.4839L14.5009 13.0639C14.1549 13.1529 13.839 13.3329 13.5861 13.5852C13.3332 13.8376 13.1526 14.1531 13.0629 14.4989L11.4839 20.6249C11.4575 20.7266 11.3997 20.8174 11.3188 20.8844C11.2379 20.9514 11.138 20.9912 11.0331 20.9981C10.9283 21.0051 10.824 20.9789 10.7349 20.9232C10.6458 20.8675 10.5765 20.7852 10.5369 20.6879L4.0369 4.6879Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg></div>
                      <div class="label-medium">Interactive Elements</div>
                    </div>
                    <div class="style-guide-content-right-block">
                      <div class="interactive-content-block">
                        <div class="button-varients-block">
                          <div class="button-varients-title-block">
                            <div class="label-large">Button Variants</div>
                          </div>
                          <div class="button-varients-content-block">
                            <a href="#" data-wf--primary-button--variant="varient-1" class="primary-button w-inline-block">
                              <div class="button-text-block">
                                <div class="button-text is-1">Button Text</div>
                                <div class="button-text is-2">Button Text</div>
                              </div>
                            </a>
                            <a href="#" class="secondary-button w-inline-block">
                              <div class="button-text-block">
                                <div class="button-text is-1">Button Text</div>
                                <div class="button-text is-2">Button Text</div>
                              </div>
                            </a>
                          </div>
                        </div>
                        <div class="icon-varients-block">
                          <div class="icon-varients-title-block">
                            <div class="label-large">Icon</div>
                          </div>
                          <div class="icon-varients-content-block"><img loading="lazy" src="/images/List-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/testimonial-star-icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/checkmark-icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/subtitle-icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/menu-icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Menu-Close-Icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Arrow-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/select-arrow-icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/form-field-Icon.svg" alt="style-guide-icon" class="style-guide-icon"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <section class="section_cta">
          <div class="section-gap">
            <div class="w-layout-blockcontainer container-main w-container">
              <div class="cta-wrapper">
                <div class="cta-content-block">
                  <div data-w-id="53cb5297-990c-9364-7ad8-fd5810eb3b07" class="cta-title-block">
                    <h2 class="heading-style-2 text-align-center text-color-heading-color title-animation">Ready To Build The Future Of Your Business?</h2>
                  </div>
                  <div data-w-id="53cb5297-990c-9364-7ad8-fd5810eb3b0a" class="cta-summary-block">
                    <p class="text-size-large text-align-middle text-color-heading-color-0-8">Join 10,000+ companies who use Aura AI to scale their intelligence and automate their workflows.</p>
                  </div>
                  <div data-w-id="53cb5297-990c-9364-7ad8-fd5810eb3b0d" class="cta-avatar-block"><img loading="lazy" src="/images/cta-avatar-1.svg" alt="cta-avatar" class="cta-avatar is-1"><img loading="lazy" src="/images/cta-avatar-2.svg" alt="cta-avatar" class="cta-avatar"><img loading="lazy" src="/images/cta-avatar-3.svg" alt="cta-avatar" class="cta-avatar"><img loading="lazy" src="/images/cta-avatar-4.svg" alt="cta-avatar" class="cta-avatar"></div>
                  <div data-w-id="53cb5297-990c-9364-7ad8-fd5810eb3b12" class="cta-button-block">
                    <a href="/contact" data-wf--primary-button--variant="varient-3" class="primary-button w-variant-cb037575-caf5-14db-03c9-2aab23927600 w-inline-block">
                      <div class="button-text-block">
                        <div class="button-text is-1">Get Started Now</div>
                        <div class="button-text is-2">Get Started Now</div>
                      </div>
                    </a>
                    <a href="/contact" class="secondary-button w-inline-block">
                      <div class="button-text-block">
                        <div class="button-text is-1">Talk to Sales</div>
                        <div class="button-text is-2">Talk to Sales</div>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <div class="page-liner-block">
          <div class="page-liner"></div>
          <div class="page-liner"></div>
          <div class="page-liner"></div>
          <div class="page-liner"></div>
          <div class="page-liner"></div>
        </div>
      </main>
</Layout>
