---
import Layout from '../layouts/Layout.astro';

// The design for this page ships in the theme stylesheet (.utility-form-* and
// .protected-page-*) but the builder export never included the page itself, so
// the markup is rebuilt here from those classes and the Protected Image asset.
//
// It reuses the 404 page id so the shared header and footer interactions have
// the same data to work with; the page itself has no interactions of its own.
---

<Layout title="Password || AI technology Astro theme" pageId="6a706af464122f0e823f2946">
  <div class="main-wrapper">
    <div class="utility-page-wrapper">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="utility-page-wrap">
            <div class="utility-form-block w-form">
              <form id="password-form" name="password-form" data-name="Password" method="post" class="utility-form-innner-block">
                <img src="/images/Protected-Image_1Protected Image.avif" loading="lazy" alt="protected-page" class="utility-form-image">
                <div class="utility-form-text-block">
                  <!-- .protected-page-title only sets a size, so the theme's white text utility supplies the colour. -->
                  <h1 class="protected-page-title text-color-white">This Page Is Protected</h1>
                  <p class="protected-page-summary">Enter the password you were given to unlock this page and continue.</p>
                </div>
                <div class="utility-form-field-block">
                  <input class="utility-form-text-field w-input" maxlength="256" name="pass" data-name="pass" placeholder="Enter your password" type="password" id="pass" required>
                </div>
                <div class="utility-form-button-block">
                  <input type="submit" data-wait="Please wait..." class="utility-form-button w-button" value="Unlock Page">
                </div>
                <div class="utility-form-bottom-block">
                  <div class="utility-form-bottom-text">Don&#x27;t have the password?</div>
                  <a href="/contact" class="utility-form-bottom-link">Contact us</a>
                </div>
              </form>
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! That password is incorrect.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  // A static site cannot check a password. The form demonstrates the error
  // state so the page is usable as a template; wire it to your host's own
  // protection (or an endpoint of your own) to make it do real work.
  document.getElementById('password-form')?.addEventListener('submit', function (event) {
    event.preventDefault();
    var block = this.closest('.w-form');
    this.style.display = 'none';
    block.querySelector('.w-form-fail').style.display = 'block';
  });
</script>
